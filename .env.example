# Bu dosyayı ".env" adıyla kopyalayın. .env dosyası Git'e eklenmez.

DATABASE_URL="postgresql://postgres:SIFRE@localhost:5432/oner_yapi?schema=public"
# API testleri bu ayrı veritabanını kullanır (içi her test başında temizlenir)
TEST_DATABASE_URL="postgresql://postgres:SIFRE@localhost:5432/oner_yapi_test?schema=public"

# İlk Super Admin (yalnız "npm run db:seed" sırasında kullanılır)
SEED_ADMIN_EMAIL="admin@oneryapi.local"
SEED_ADMIN_PASSWORD="en-az-12-karakterlik-guclu-sifre"

# Ürün görsellerinin kaydedileceği klasör (S3/Cloudinary'ye geçince değişecek)
UPLOAD_DIR="storage/uploads"

# Sitenin herkese açık adresi. CANLIDA ZORUNLU: tanımlı değilse robots.txt tüm siteyi kapatır.
# SITE_URL="https://www.alanadiniz.com.tr"
# Ödeme geri dönüş adresinin kökü (genellikle SITE_URL ile aynı)
# PUBLIC_BASE_URL="https://www.alanadiniz.com.tr"

# iyzico — anahtarlar yalnız burada tutulur, koda yazılmaz.
# Test (sandbox) anahtarları: https://sandbox-merchant.iyzipay.com → Ayarlar → Firma Ayarları
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
# Boş bırakılırsa sandbox kullanılır. Canlı için: https://api.iyzipay.com (yalnız canlı anahtarlarla)
IYZICO_BASE_URL=""
